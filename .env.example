# Address of the deployed Intent Guard Intelligent Contract.
# Leave unset to browse the app against the bundled fixtures (src/lib/mock-data.ts).
# Set it, and every read/write in src/lib/genlayer/data-source.ts switches to the live contract.
NEXT_PUBLIC_INTENT_GUARD_CONTRACT=0x971406b8F8efFA474F19657d7e55549A17e2b157

# GenLayer JSON-RPC endpoint and chain. Defaults below are StudioNet.
NEXT_PUBLIC_GENLAYER_ENDPOINT=https://studio.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN=studionet

# Force the data source regardless of the contract address: "live" | "fixtures".
# Unset means: live when a contract address is configured, fixtures otherwise.
NEXT_PUBLIC_INTENT_GUARD_DATA=live
