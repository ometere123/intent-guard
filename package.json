{
  "name": "intent-guard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify:schema": "node scripts/verify-schema.mjs",
    "verify:deployment": "node scripts/verify-deployment-source.mjs",
    "verify:studionet": "node scripts/exercise-studionet.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm test && npm run verify:deployment && npm run typecheck && npm run lint && npm run build",
    "check": "npm run verify"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
